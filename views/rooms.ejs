<%- include('partials/head', { title: 'Comfort Hotel - Rooms' }) %>
<%- include('partials/navbar', { activePage: 'rooms' }) %>

<main class="container py-4">
  <h2 class="mb-4">Our Rooms</h2>
  
  <div class="mb-4">
    <button class="btn btn-outline-danger filter-btn active" data-filter="all">All Rooms</button>
    <% rooms.forEach(room => { %>
      <button class="btn btn-outline-danger filter-btn" data-filter="<%= room.type %>"><%= room.name %></button>
    <% }); %>
  </div>

  <div class="row g-4" id="roomsContainer">
    <% rooms.forEach((room, index) => { 
      // Pick a random image based on index for variety
      const imgIndex = (index % 3) + 1;
    %>
    <div class="col-md-4 room-item" data-category="<%= room.type %>">
      <div class="card room-card h-100">
        <img src="<%= imgIndex %>.jpg" class="card-img-top gallery-img" alt="<%= room.name %>" data-room="<%= room.type %>">
        <div class="card-body">
          <h5 class="card-title"><%= room.name %></h5>
          <p class="card-text">Total available: <%= room.count %></p>
          <p class="card-text"><strong>Price: <span class="room-price" data-base="<%= room.price %>">$<%= room.price %></span>/night</strong></p>
          <a href="/booking?roomType=<%= room.type %>&roomName=<%= encodeURIComponent(room.name) %>" class="btn btn-danger">Book Now</a>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

  <h2 class="mt-5">Room Pricing Table</h2>
  <table class="table table-striped mt-3">
    <thead class="table-dark">
      <tr>
        <th>Room Type</th>
        <th>Price/Night</th>
        <th>Total Available</th>
      </tr>
    </thead>
    <tbody>
      <% rooms.forEach(room => { %>
      <tr>
        <td><%= room.name %></td>
        <td><span class="table-price" data-base="<%= room.price %>">$<%= room.price %></span></td>
        <td><%= room.count %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</main>

<div class="modal fade" id="imageModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">Room Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <img id="modalImage" src="" class="img-fluid" alt="Room">
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<script>
let exchangeRates = {};

$(document).ready(function() {
  loadCurrency();
  fetchExchangeRates();

  $('.room-item').hide().each(function(index) {
    $(this).delay(200 * index).fadeIn(600);
  });

  $('.filter-btn').click(function() {
    $('.filter-btn').removeClass('active');
    $(this).addClass('active');
    
    const filter = $(this).attr('data-filter');
    
    if (filter === 'all') {
      $('.room-item').fadeIn(500);
    } else {
      $('.room-item').each(function() {
        if ($(this).attr('data-category') === filter) {
          $(this).fadeIn(500);
        } else {
          $(this).fadeOut(500);
        }
      });
    }
  });

  $('.gallery-img').click(function() {
    const src = $(this).attr('src');
    const alt = $(this).attr('alt');
    
    $('#modalImage').attr('src', src);
    $('#modalTitle').text(alt);
    
    const modal = new bootstrap.Modal(document.getElementById('imageModal'));
    modal.show();
  });

  $('.gallery-img').hover(
    function() {
      $(this).css({
        'cursor': 'pointer',
        'opacity': '0.8'
      });
    },
    function() {
      $(this).css('opacity', '1');
    }
  );

  $('table tbody tr').hover(
    function() {
      $(this).css('background-color', 'lightblue');
    },
    function() {
      $(this).css('background-color', '');
    }
  );

  $('#currencySelector').change(function() {
    const currency = $(this).val();
    saveCurrency(currency);
    updateAllPrices();
  });
});

function fetchExchangeRates() {
  const savedRates = localStorage.getItem('exchangeRates');
  
  if (savedRates) {
    exchangeRates = JSON.parse(savedRates);
    updateAllPrices();
  }
  
  const url = 'https://api.exchangerate-api.com/v4/latest/USD';
  
  $.ajax({
    url: url,
    method: 'GET',
    success: function(data) {
      exchangeRates = data.rates;
      localStorage.setItem('exchangeRates', JSON.stringify(exchangeRates));
      updateAllPrices();
    },
    error: function() {
      console.log('Failed to fetch exchange rates');
    }
  });
}

function saveCurrency(currency) {
  localStorage.setItem('selectedCurrency', currency);
}

function loadCurrency() {
  const saved = localStorage.getItem('selectedCurrency');
  if (saved) {
    $('#currencySelector').val(saved);
  }
}

function getCurrencySymbol(currency) {
  const symbols = {
    'USD': '$',
    'EUR': '€',
    'KZT': '₸',
    'RUB': '₽'
  };
  return symbols[currency] || currency;
}

function updateAllPrices() {
  const currency = $('#currencySelector').val();
  const rate = exchangeRates[currency] || 1;
  const symbol = getCurrencySymbol(currency);
  
  $('.room-price').each(function() {
    const basePrice = parseFloat($(this).attr('data-base'));
    const convertedPrice = Math.round(basePrice * rate);
    $(this).text(symbol + convertedPrice);
  });
  
  $('.table-price').each(function() {
    const basePrice = parseFloat($(this).attr('data-base'));
    const convertedPrice = Math.round(basePrice * rate);
    $(this).text(symbol + convertedPrice);
  });
}
</script>
</body>
</html>
