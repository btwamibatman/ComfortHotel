<%- include('partials/head', { title: 'Comfort Hotel - Contact' }) %>
<%- include('partials/navbar', { activePage: 'contact' }) %>

<main class="container py-5">
  <div class="row">
    <div class="col-md-6">
      <h2 class="mb-4">Contact Us</h2>
      
      <div class="card">
        <div class="card-body">
          <form id="contactForm" method="POST" action="/contact" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="name" class="form-label">Name</label>
              <input type="text" class="form-control" id="name" name="name" required>
              <div class="invalid-feedback">Please enter your name.</div>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email" required>
              <div class="invalid-feedback">Please enter a valid email address.</div>
            </div>

            <div class="mb-3">
              <label for="message" class="form-label">Message</label>
              <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
              <div class="invalid-feedback">Please enter your message.</div>
            </div>

            <button type="submit" class="btn btn-danger btn-lg">Send Message</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <h3 class="mb-4">Our Information</h3>
      <div class="contact-info">
        <div class="info-item mb-3 p-3 border rounded">
          <h5>Email</h5>
          <p>maga25@gmail.com</p>
        </div>
        <div class="info-item mb-3 p-3 border rounded">
          <h5>Phone</h5>
          <p>+7 777 777 77 77</p>
        </div>
        <div class="info-item mb-3 p-3 border rounded">
          <h5>Address</h5>
          <p>Astana, Kazakhstan</p>
        </div>
        <div class="info-item mb-3 p-3 border rounded">
          <h5>Working Hours</h5>
          <p>Monday - Friday: 9:00 AM - 6:00 PM</p>
          <p>Saturday - Sunday: 10:00 AM - 4:00 PM</p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
$(document).ready(function() {
  $('.info-item').hide().each(function(index) {
    $(this).delay(200 * index).fadeIn(600);
  });

  $('.info-item').hover(
    function() {
      $(this).css('background-color', 'lightgray');
    },
    function() {
      $(this).css('background-color', 'white');
    }
  );

  $('#contactForm').submit(function(e) {
    const form = this;
    if (!form.checkValidity()) {
      e.preventDefault();
      e.stopPropagation();
      form.classList.add('was-validated');
      return false;
    }
  });
});
</script>

<%- include('partials/currency-script') %>
</body>
</html>
