<%- include('partials/head', { title: 'Comfort Hotel - About Us' }) %>
<%- include('partials/navbar', { activePage: 'about' }) %>

<main>
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">About Us</div>
      <h1 class="page-title text-white">Hospitality with comfort and care</h1>
      <p>Comfort Hotel has been welcoming guests since 2010 with quality service, thoughtful amenities, and memorable stays.</p>
    </div>
  </section>

  <section class="page-content">
    <div class="container">
      <div class="row g-4 align-items-stretch mb-5">
        <div class="col-lg-5">
          <div class="booking-aside">
            <div class="eyebrow">Our Story</div>
            <h2 class="h1">Comfort Hotel</h2>
            <p>Our mission is to make every stay feel calm, refined, and easy from booking to check-out.</p>
            <p class="mb-0">We focus on clean design, reliable service, and practical comfort for business and leisure guests.</p>
          </div>
        </div>
        <div class="col-lg-7">
          <div class="hotel-card p-4 p-md-5 h-100">
            <div class="eyebrow">Why guests return</div>
            <h2 class="h1 mb-3">Premium service without complexity</h2>
            <p class="lead hotel-muted">Comfort Hotel combines modern amenities, friendly support, and a central location so guests can focus on the purpose of their trip.</p>
            <div class="row g-3 mt-3">
              <div class="col-sm-4">
                <div class="trust-item justify-content-start"><span class="trust-dot"></span>Since 2010</div>
              </div>
              <div class="col-sm-4">
                <div class="trust-item justify-content-start"><span class="trust-dot"></span>24/7 Service</div>
              </div>
              <div class="col-sm-4">
                <div class="trust-item justify-content-start"><span class="trust-dot"></span>Central Location</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="section-heading">
        <div class="eyebrow">Amenities</div>
        <h2>Everything for a comfortable stay</h2>
        <div class="section-rule"></div>
      </div>

      <div class="row g-4 mb-5">
        <div class="col-md-6">
          <div class="hotel-card amenity-card hover-lift">
            <h3 class="h5">Free Wi-Fi</h3>
            <p class="hotel-muted mb-0">High-speed internet access throughout the hotel.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="hotel-card amenity-card hover-lift">
            <h3 class="h5">Breakfast Included</h3>
            <p class="hotel-muted mb-0">Complimentary breakfast buffet every morning.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="hotel-card amenity-card hover-lift">
            <h3 class="h5">Swimming Pool</h3>
            <p class="hotel-muted mb-0">Indoor heated pool available year-round.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="hotel-card amenity-card hover-lift">
            <h3 class="h5">Gym & Spa</h3>
            <p class="hotel-muted mb-0">Modern fitness center and relaxing spa services.</p>
          </div>
        </div>
      </div>

      <div id="faq" class="hotel-card p-4 p-md-5">
        <div class="eyebrow">Support</div>
        <h2 class="h1 mb-4">Frequently Asked Questions</h2>
        <div class="accordion" id="faqAccordion">
          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                What are the check-in and check-out times?
              </button>
            </h3>
            <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body">
                Check-in time is 2:00 PM and check-out time is 11:00 AM. Early check-in and late check-out may be available upon request.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                Do you offer airport transportation?
              </button>
            </h3>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body">
                Yes, we provide airport shuttle service for an additional fee. Please contact us in advance to arrange pickup.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                Is parking available?
              </button>
            </h3>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body">
                Yes, we offer free parking for all guests. Valet parking is also available at an additional cost.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                Are pets allowed?
              </button>
            </h3>
            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body">
                Yes, we are a pet-friendly hotel. A small additional fee applies for pets. Please inform us in advance.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                What is your cancellation policy?
              </button>
            </h3>
            <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body">
                Free cancellation up to 24 hours before check-in. Cancellations within 24 hours will incur a one-night charge.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

<script>
$(document).ready(function() {
  loadCurrency();
  $('.amenity-card').hide().each(function(index) {
    $(this).delay(120 * index).fadeIn(420);
  });
});
</script>

<%- include('partials/currency-script') %>
</body>
</html>
