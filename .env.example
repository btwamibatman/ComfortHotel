NODE_ENV=development
PORT=3000
DB_PASSWORD=your_secure_db_password
DATABASE_URL=
PRODUCT_SERVICE_URL=
CHAT_SERVICE_URL=
SESSION_SECRET=your-secret-key-change-in-production
SESSION_TTL_SECONDS=86400

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_EMAIL=admin@comforthotel.local
ADMIN_FULL_NAME=Administrator

MANAGER_USERNAME=manager
MANAGER_PASSWORD=change_me_manager_password
MANAGER_EMAIL=manager@comforthotel.local
MANAGER_FULL_NAME=Hotel Manager

# Optional standard user
# USER_USERNAME=user
# USER_PASSWORD=change_me_user_password
# USER_EMAIL=user@comforthotel.local
# USER_FULL_NAME=Front Desk User

# Optional Alertmanager notification routing values are configured in:
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/REAL/WEBHOOK
SLACK_CHANNEL="#alerts"
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@comforthotel.local
SMTP_AUTH_USERNAME=alerts@comforthotel.local
SMTP_AUTH_PASSWORD=change_me_smtp_password
ALERT_EMAIL_TO=oncall@comforthotel.local
